{
  "manifest_version": 3,
  "name": "Fwork Companion",
  "version": "1.0.0",
  "description": "Capture web pages and save them to your Fwork boards instantly.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Save to Fwork"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*.vercel.app/*"
  ]
}
